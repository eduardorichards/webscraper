# Environment configuration for the job scraper.
#
# Copy to .env and uncomment what you want to change. Every value below is the
# default, so an empty .env (or no .env at all) behaves exactly the same.
#
# FORMAT RULES: this file is read by bash `source` (run_scraper.sh), systemd
# `EnvironmentFile` (job-scraper-web.service) and python-dotenv, so keep it to
# what all three parse identically:
#   - plain KEY=value lines, no spaces around `=`
#   - no quotes around values
#   - no inline comments; comments go on their own line starting with #
#   - no `export`, no variable expansion ($VAR), no `~` in paths
# Real environment variables take precedence over values in .env.

# --- Web app (web_app.py) ---

# Port the Flask app listens on (1-65535)
# PORT=5000

# Interface to bind; use 127.0.0.1 to accept local connections only
# HOST=0.0.0.0

# Flask debug mode (true/false). Only allowed with HOST=127.0.0.1, localhost
# or ::1: the Werkzeug debugger allows remote code execution.
# FLASK_DEBUG=false

# Default results per page; must be one of 25, 50, 100, 200
# DEFAULT_PER_PAGE=50

# --- Storage and logging ---

# SQLite database file; relative paths resolve from the project root
# DB_PATH=data/database/jobs_master.db

# Directory for scraper.log, cron.log and scraper.lock; relative paths
# resolve from the project root
# LOG_DIR=data/logs

# Log level: DEBUG, INFO, WARNING, ERROR or CRITICAL
# LOG_LEVEL=INFO

# --- Detail page scraping (rate limiting) ---

# Random delay between job detail requests, in seconds (min <= max)
# SCRAPE_MIN_DELAY=2
# SCRAPE_MAX_DELAY=4

# Pause for BATCH_PAUSE seconds after every BATCH_SIZE jobs
# BATCH_SIZE=50
# BATCH_PAUSE=30

# On HTTP 429, wait RETRY_DELAY seconds and retry up to MAX_RETRIES times
# RETRY_DELAY=60
# MAX_RETRIES=3

# --- Search (main.py) ---

# Random delay between search templates and between result pages of one
# search, in seconds (min <= max)
# SEARCH_MIN_DELAY=2
# SEARCH_MAX_DELAY=4

# Result pages fetched per search template (1-100): the search page (up to
# 60 jobs) plus "See more jobs" pages (10 jobs each). 4 = up to 90 jobs.
# SEARCH_MAX_PAGES=4
